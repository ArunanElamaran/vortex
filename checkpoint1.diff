+  static bool compare(float a, float b, int index, int errors) {
+    union fi_t {
+      float f;
+      int32_t i;
+    };
+    fi_t fa, fb;
+    fa.f = a;
+    fb.f = b;
+    auto d = std::abs(fa.i - fb.i);
+    if (d > FLOAT_ULP) {
+      if (errors < MAX_ERRORS) {
