+#define OTYPE fp32
+#endif
+
+// Tensor memory base address for accumulator storage
+#ifndef TMEM_ACCUM_BASE
+#define TMEM_ACCUM_BASE TMEM_BASE_ADDR
+#endif
+
+typedef struct {
+  uint32_t grid_dim[2];
+  uint32_t block_dim[2];
+  uint32_t M, N, K;
+  uint64_t A_addr;
+  uint64_t B_addr;
+  uint64_t C_addr;
+} kernel_arg_t;
